# RapidFix Backend Environment Variables Template
# Copy this file to '.env' in this directory (backend root) for local development

# MongoDB Configuration (Defaults to local MongoDB if not set)
MONGODB_URL=your_mongodb_connection_string_here
MONGODB_DB_NAME=rapid_fix_db
MONGODB_MAX_POOL_SIZE=10
MONGODB_TIMEOUT=5000

# Firebase Client Configuration (Returned safely to frontend via API if VITE_ prefix is active)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MESAURE_ID=your_firebase_measurement_id_here

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUD_API_KEY=your_cloudinary_api_key_here
CLOUD_API_SECRET=your_cloudinary_api_secret_here

# Optional custom secrets (will fall back to default if left unconfigured)
# JWT_SECRET=your_jwt_signing_secret
# PORT=3000
